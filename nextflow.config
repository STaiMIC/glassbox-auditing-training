profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
}

process {
    resourceLimits = [
        cpus   : 2,
        memory : 6.GB,
        time   : '20.min'
    ]
}

manifest {
    name            = 'glassbox-ai-triage'
    description     = 'Reproducible, auditable provenance harness for automated variant triage after nf-core/sarek'
    version         = '0.1.0'
}
